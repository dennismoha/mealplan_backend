# Runtime
NODE_ENV=development
PORT=3000
BASE_URL=api

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
PRISMA_POOL_LIMIT=10
PRISMA_POOL_TIMEOUT_MS=30000
PRISMA_POOL_IDLE_SECONDS=60
MYSQL_USER=mealplan
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=meal_plan

# Initial administrator (used idempotently during startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword@123

# Authentication
COOKIE_PASSWORD=replace-with-a-long-random-value
ACCESS_TOKEN_SECRET=replace-with-a-different-long-random-value
REFRESH_TOKEN_SECRET=replace-with-another-long-random-value
SESSION_NAME=mealplan.sid

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
LOCAL_REDIS_HOST=127.0.0.1

# Cloudinary (CLOUDINARY_URL is intentionally unnecessary)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
